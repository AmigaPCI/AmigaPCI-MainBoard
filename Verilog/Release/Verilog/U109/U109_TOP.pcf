#DATA TRANSFER SIGNALS
set_io TACKn    23
set_io TSn      33
set_io CPU_BUSn 32
set_io TBIn     19
set_io RnW      17
set_io BURSTn   16
#set_io TACKn_OUT 23
#set_io TACKn_IN  21
#set_io TSn_OUT   33
#set_io TSn_IN    20

#PCI CYCLE SIGNALS
set_io STOPn              38
set_io PCI_RSTn          128
set_io W_LATCH_ENn        44

set_io PCI_TIPn           26
set_io PCI_BUF_DIR        28
set_io PARITY_DIR         34
set_io PCI_CYCLEn         18
set_io BRIDGE_ENn         47
set_io PARITY_DA          15
set_io TARGET_READYn      12
set_io INIT_READYn        11
set_io IDSEL[0]           48
set_io IDSEL[1]           61
set_io IDSEL[2]           55
