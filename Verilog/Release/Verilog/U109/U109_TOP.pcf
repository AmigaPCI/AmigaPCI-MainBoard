#Pin 41 is an extra signal to U110 that is currently not defined.
#Pin 24 is an extra signal to U409 that is currently not defined.
#Pin 10 (DEVSELn) is not used.

#CLOCKS
set_io CLK40_IN   49
set_io CLK33_IN  129
set_io RESETn     25

#AD BUS
set_io AD[0]    2 #AD0
set_io AD[1]    1 #AD1
